VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Philips Hue bridge — local LAN only, called client-side from the browser.
# Values are visible in the client bundle by design; the bridge is unreachable
# off the home network anyway.
VITE_HUE_BRIDGE_IP=192.168.1.x
VITE_HUE_API_KEY=your-hue-api-key
